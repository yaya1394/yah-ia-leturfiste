rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /races/{raceId} {
      allow read: if true;
      allow write: if false;
      
      match /participants/{participantId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /horses/{horseId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
